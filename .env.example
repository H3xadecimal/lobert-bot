# Copy this file to .env and fill in your own values.
# Use a separate bot and server for local testing. Never commit .env.

# Discord Developer Portal > application > Bot > token
DISCORD_TOKEN=your_test_bot_token

# Discord Developer Portal > application > General Information > Application ID
CLIENT_ID=your_application_id

# Discord test server ID (enable Developer Mode, then Copy Server ID)
GUILD_ID=your_test_server_id
